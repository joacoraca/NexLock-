rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Logs de acceso:
    // ESP32 y panel web pueden leer y registrar eventos.
    // Se bloquea la modificación o eliminación para mantener auditoría.
    match /logs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // 2. Usuarios:
    // Lectura permitida para validar PIN (ESP32 y panel).
    // Creación, edición y borrado exclusivo para administradores autenticados en el panel web.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Rostros de referencia:
    // Lectura permitida para comparación biométrica (ESP32-CAM y panel).
    // Creación y actualización exclusiva para administradores autenticados.
    match /faces/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. Estado de los dispositivos (Heartbeat de ESP32 y ESP32-CAM):
    match /devices/{deviceId} {
      allow read, write: if true;
    }
  }
}
